rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read, create, update: if ownsUser(userId);
      allow delete: if false;

      match /sessions/{sessionId} {
        allow read: if ownsUser(userId);
        allow write: if false;
      }

      match /events/{eventId} {
        allow read: if ownsUser(userId);
        allow write: if false;
      }

      match /daily_aggregates/{dateId} {
        allow read: if ownsUser(userId);
        allow write: if false;
      }

      match /watch_data/{dateId} {
        allow read: if ownsUser(userId);
        allow create, update: if ownsUser(userId)
          && request.resource.data.keys().hasOnly([
            "steps", "calories", "distance_km", "active_min", "last_synced_at"
          ])
          && request.resource.data.steps is int
          && request.resource.data.steps >= 0;
        allow delete: if false;
      }

      match /control_commands/{commandId} {
        allow read: if ownsUser(userId);
        allow create: if ownsUser(userId)
          && request.resource.data.from == "web"
          && request.resource.data.status == "pending"
          && request.resource.data.action in ["force_stop", "switch_mode"];
        allow update, delete: if false;
      }
    }
  }
}
