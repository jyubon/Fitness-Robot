# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=fitness_robot

# JWT
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_FOR_PRODUCTION
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Server
PORT=8000

# For Pi publishing: set the backend base URL the Pi can reach
# BACKEND_BASE_URL=http://YOUR_BACKEND_IP:8000

# CORS (optional tightening later)
# ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
