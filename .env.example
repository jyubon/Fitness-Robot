# Dashboard account used by the Raspberry Pi publisher.
# With one Firebase Auth account these can stay blank; it is selected automatically.
# With multiple accounts, set either the UID or the login email.
FIREBASE_USER_ID=
FIREBASE_USER_EMAIL=

# Optional legacy FastAPI fallback. Generate a fresh token with /auth/login.
BACKEND_BASE_URL=http://localhost:8000
BACKEND_TOKEN=

# ElevenLabs Text-to-Speech (used to generate & permanently cache voice clips in voice/tts_cache/)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=6psAnGNeDguzLyTxKYvI
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_SPEED=0.9
ELEVENLABS_STABILITY=0.50
ELEVENLABS_SIMILARITY_BOOST=0.75
ELEVENLABS_STYLE=0.06
ELEVENLABS_SPEAKER_BOOST=true
